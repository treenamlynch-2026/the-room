# Server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# How the models address you
HUMAN_NAME=Director

# Everyday models (changeable per project in the Agents tab)
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-sonnet-5-5
# Deep models: used only by the Deep chip and "Deep review"
OPENAI_DEEP_MODEL=gpt-6-astra
ANTHROPIC_DEEP_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=8000

# Media
IMAGE_MAX_EDGE=1568          # images are downscaled to this long edge once, at upload
VIDEO_MAX_FRAMES=12          # evenly spaced frames per video
VIDEO_FRAME_WIDTH=768
MEDIA_WINDOW=6               # message attachments are re-sent while within the last N messages
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: require a password (HTTP Basic auth, any username). Leave blank for single-user localhost mode.
APP_PASSWORD=

# Messages kept verbatim in context (Layer E). Older ones go into the summary (Layer F).
RECENT_WINDOW=30
